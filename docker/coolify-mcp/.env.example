# Coolify API endpoint and API token.
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_ACCESS_TOKEN=

# Dedicated ingress credential required by Caddy.
MCP_PROXY_BEARER_TOKEN=

# Bind the published listener to the deployment host's private VPN address.
MCP_PROXY_PORTS=100.64.0.1:18084:8080

# Bifrost does not currently support MCP elicitation; fail-safe confirmations
# remain represented by the client's own tool permission controls.
COOLIFY_MCP_ELICITATION=off
