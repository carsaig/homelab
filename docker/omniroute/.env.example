# Required deployment variables. Keep real values outside version control.

OMNIROUTE_PORT=
OMNIROUTE_API_PORT=
OMNIROUTE_LIVE_WS_PORT=
OMNIROUTE_BIND_ADDRESS=
REDIS_URL=
MEMORY_NETWORK_NAME=
OMNIROUTE_DATA_VOLUME=
OMNIROUTE_REDIS_VOLUME=

# Public origin this instance is served behind, e.g. https://your-domain.example
BASE_URL=

# Session-signing secret. Generate: openssl rand -base64 48
JWT_SECRET=

# Encrypts API keys stored in the app's database. Generate: openssl rand -hex 32
API_KEY_SECRET=

# Encrypts the app's database at rest. Generate: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=

# Initial dashboard login credential.
INITIAL_PASSWORD=

# Hostname(s) allowed to open the dashboard's live-monitoring WebSocket.
LIVE_WS_ALLOWED_HOSTS=

# Public WebSocket URL, matching BASE_URL with the ws(s):// scheme and the
# live-monitoring path, e.g. wss://your-domain.example/live-ws
LIVE_WS_PUBLIC_URL=

# Existing LLM gateway this instance delegates upstream routing to.
BIFROST_BASE_URL=

# Dedicated gateway credential scoped to this instance only.
BIFROST_API_KEY=

# Host directory containing the required CLI installation and configuration.
HOST_HOME_DIR=
HOST_CLAUDE_BINARY_PATH=
CLI_MODE=
CLI_ALLOW_CONFIG_WRITES=
