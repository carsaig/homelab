# Forgejo — configuration contract
#
# This file documents the variables the compose definition expects. It contains
# no values. Real values are supplied by the deployment platform's environment
# settings, sourced from the secret manager. Never commit resolved values.

# --- Images ------------------------------------------------------------------
# Pin exact tags. The deployment platform does not re-pull on redeploy, only on
# tag change, so a floating tag silently freezes the running version.
FORGEJO_IMAGE=          # codeberg.org/forgejo/forgejo:<major.minor.patch>
POSTGRES_IMAGE=         # postgres:<major>-alpine

# --- Identity ----------------------------------------------------------------
# ROOT_URL is permanent. Changing it after repositories exist invalidates
# clone URLs, webhook targets and OIDC redirect URIs.
FORGEJO_DOMAIN=         # bare hostname
FORGEJO_ROOT_URL=       # https://<hostname>/  — note the trailing slash
FORGEJO_HTTP_PORT=      # container-internal HTTP port

# --- Git over SSH ------------------------------------------------------------
# ADVERTISED is what appears in clone URLs; LISTEN is the in-container bind.
# They differ because the host's own sshd already owns the standard port.
FORGEJO_SSH_DOMAIN=
FORGEJO_SSH_ADVERTISED_PORT=
FORGEJO_SSH_LISTEN_PORT=
FORGEJO_SSH_BIND=       # <interface-address>:<host-port>:<container-port>
                        # Bind to the private-network interface only, never 0.0.0.0.

# --- Runtime user ------------------------------------------------------------
FORGEJO_UID=
FORGEJO_GID=
FORGEJO_LOG_LEVEL=      # Info in steady state; Debug only while diagnosing

# --- Database ----------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=      # op:// reference — resolved by the platform, never inline

# --- Platform wiring ---------------------------------------------------------
PROXY_NETWORK_NAME=     # existing external reverse-proxy network
FORGEJO_DATA_VOLUME=    # pre-created external volume, backed by the data mount
FORGEJO_DB_VOLUME=      # pre-created external volume, backed by the data mount
