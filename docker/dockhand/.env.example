# Copy to .env and fill in real values. Never commit .env itself.

# Postgres password for the dockhand database user.
POSTGRES_PASSWORD=

# Tailscale OAuth client (Zero Trust → Settings → OAuth clients) scoped to
# Services:Write + Devices:Read/Write, tagged with your docktail service tag.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# Host directory bind-mounted into the dockhand container so its file browser
# can see host-side compose files (docker.sock alone only grants API control,
# not filesystem access). Set this to your own home directory, e.g. /home/you
HOST_HOME_DIR=
