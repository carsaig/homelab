# Copy to .env and fill in real values. Never commit .env itself.

# Your Karakeep instance's base URL (not KARAKEEP_SERVER_ADDR — different
# Karakeep components use different variable names for the same setting).
KARAKEEP_API_ADDR=

# API key for the Karakeep instance above.
KARAKEEP_API_KEY=

# Bearer token the reverse-proxy auth gate requires on every request.
MCP_PROXY_BEARER_TOKEN=

# Deployment-specific port binding supplied by the secret manager or PaaS.
MCP_PROXY_PORTS=
