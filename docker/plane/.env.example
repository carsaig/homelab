# Variable names only. Values are injected at deploy time from the secret
# manager; nothing in this file is ever populated in version control.

# --- Image selection -------------------------------------------------------
# Pin an explicit release tag. A floating tag lets the long-running services
# advance while the one-shot migrator stays behind, which strands the API.
PLANE_REGISTRY=
PLANE_IMAGE_TAG=
REDIS_VERSION=
POSTGRES_VERSION=
RABBITMQ_VERSION=
MINIO_VERSION=

# --- Host placement --------------------------------------------------------
PLANE_RUN_AS=
PLANE_REDIS_PATH=
PLANE_DB_PATH=
PLANE_RABBITMQ_PATH=
PLANE_UPLOADS_PATH=
PLANE_PROXY_PORTS=
TZ=

# --- Datastore -------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=

# --- Message broker --------------------------------------------------------
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
AMQP_URL=

# --- Object storage --------------------------------------------------------
USE_MINIO=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
BUCKET_NAME=
FILE_SIZE_LIMIT=

# --- Application -----------------------------------------------------------
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
DEBUG=
DJANGO_SETTINGS_MODULE=
GUNICORN_WORKERS=
WEB_URL=
API_BASE_URL=
CORS_ALLOWED_ORIGINS=
NEXT_PUBLIC_DEPLOY_URL=

# --- Ingress ---------------------------------------------------------------
SITE_ADDRESS=
TRUSTED_PROXIES=

# --- Authentication --------------------------------------------------------
ENABLE_SIGNUP=
ENABLE_EMAIL_PASSWORD=
ENABLE_MAGIC_LINK_LOGIN=
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Telemetry -------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
