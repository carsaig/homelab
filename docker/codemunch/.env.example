# Copy to .env / set these in Coolify's env UI. Never commit real values.

# Bearer token the Caddy auth gate requires on every request (the single
# mcp.<your-domain>/codemunch endpoint). Generate a strong random value:
#   openssl rand -hex 32
CODEMUNCH_BEARER_TOKEN=

# --- File cap (optional) -----------------------------------------------------
# Max files codemunch indexes per repo. Default 20000 covers large repos.
# JCODEMUNCH_MAX_FOLDER_FILES=20000
# JCODEMUNCH_MAX_INDEX_FILES=20000

# --- Embedding provider ------------------------------------------------------
# DEFAULT (all OPENAI_* unset): local ONNX all-MiniLM-L6-v2 — offline, free, but
# ~3h to embed a 100k-symbol repo on the 2-thread encoder.
#
# To use an OpenAI-compatible endpoint (e.g. Bifrost) instead — ~15min for the
# same repo — set ALL FOUR of these. Pointing JCODEMUNCH_LOCAL_EMBED_MODEL at a
# nonexistent path disables the local encoder so codemunch falls through to OpenAI.
# JCODEMUNCH_LOCAL_EMBED_MODEL=/opt/models/disabled
# OPENAI_API_KEY=            # a Bifrost virtual key (secret)
# OPENAI_BASE_URL=https://bifrost.<your-domain>/openai/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small
